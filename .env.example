# StockAI local config — copy karo:  Copy-Item .env.example .env
# `.env` .gitignore me hai → git me NAHI jaati. Real env variable .env se jeetta hai.
# Server restart karne par hi ye values lagti hain.

# ── Auth ────────────────────────────────────────────────────────────────────
# KHAALI = token OFF (LAN par khula, ghar ke liye theek).
# Internet par expose karna ho to yahan koi lamba random string daalo:
#   PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
# Token ON karne ke baad pehli baar dashboard http://<host>:5000/?token=<yahi> se kholein.
STOCKAI_API_TOKEN=

# ── Rate limit (per IP, per minute) — 0 = off ───────────────────────────────
STOCKAI_RATE_LIMIT=240

# ── Bind address ────────────────────────────────────────────────────────────
# 0.0.0.0 = LAN ke doosre devices bhi khol sakte hain (phone/TV).
# Sirf isi machine par chalana ho to 127.0.0.1 karo.
STOCKAI_HOST=0.0.0.0

# ── CORS allowlist (comma separated) — khaali = same-origin only ────────────
# Dashboard isi server se serve hota hai, isliye normally kuch daalne ki zaroorat nahi.
STOCKAI_CORS_ORIGINS=

# ── Reverse proxy ke peeche ho TABHI 1 ─────────────────────────────────────
# Warna X-Forwarded-For spoof ho sakta hai (rate-limit bucket galat banega).
STOCKAI_TRUST_PROXY=0

# ── Browser auto-open ─────────────────────────────────────────────────────
# 1 = server start hote hi dashboard browser me khul jayega (link me token juda hua).
# 0 = sirf console me links print hongi.
STOCKAI_AUTO_OPEN=1

# ── Offline / master list ─────────────────────────────────────────────────
# 1 = koi network call nahi (NSE master list cache/fallback se). Test/offline ke liye.
STOCKAI_OFFLINE=0

# ── Port ────────────────────────────────────────────────────────────────────
PORT=5000

# ── FIX-57/59: transaction cost model (cost-aware plan) ───────────────────
# App pehle T1/T2/SL/R:R gross dikhata tha — fees ka koi hisaab nahi.
# Measured (tools/study_new_signals.py): ek +0.169% gross signal round-trip cost
# me NEGATIVE ho jaata hai, isliye ye numbers matter karte hain.
#
# FIX-59: cost model ab `research/costs.py` se aata hai — SINGLE SOURCE OF TRUTH,
# notional-aware (brokerage Rs20 par capped hai, isliye chhoti position par %
# cost zyada hota hai). STATUTORY rates (STT/stamp) yahan override NAHI hote —
# wo mode par depend karte hain (delivery 0.1% DONO taraf, intraday 0.025% SIRF
# sell par), aur ek number se override karna hi FIX-57 ka bug tha.
#
# intraday = same-day buy+sell · delivery = overnight holding
STOCKAI_COST_MODE=intraday
# Slippage % per side (x2 lagta hai). Liquid large-cap 0.03-0.05,
# chhote/illiquid stock 0.10-0.20. Khaali chhodo to 0.05 (research default).
STOCKAI_COST_SLIPPAGE=
# Brokerage % per side. Zerodha/upstox flat Rs20 hai — cap neeche set hai.
STOCKAI_COST_BROKERAGE=
# Brokerage cap, Rs per order. Discount brokers par 20.
STOCKAI_COST_BROKERAGE_CAP=
# NSE equity transaction charge % per side. Sources me 0.00297 / 0.00307 /
# 0.00325 teeno milte hain — apne broker ke statement se confirm karke bharein.
STOCKAI_COST_EXCH_PCT=
